# ============================================================
# .env.example — Variables de entorno del Pipeline Judicial ASERGES
# Copiar a .env y rellenar los valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# ── OpenAI ───────────────────────────────────────────────────
# Clave de API para el análisis IA (GPT-4.1-mini)
OPENAI_API_KEY=sk-...

# ── Autenticación Google Calendar ────────────────────────────
# Modo de autenticación para agendar eventos en Google Calendar.
#   mcp  → Usa manus-mcp-cli (requiere Manus Cowork activo). Por defecto.
#   adc  → Usa Application Default Credentials con Service Account
#           Impersonation (Opción A). No depende de Cowork.
#           Requiere haber ejecutado configurar_adc_windows.bat una vez.
PIPELINE_AUTH_MODE=mcp

# Email de la Service Account (solo necesario si usas ADC)
# PIPELINE_SA_EMAIL=pipeline-judicial-sa@aserges-pipeline.iam.gserviceaccount.com

# ── Gmail IMAP/SMTP ──────────────────────────────────────────
# App Password de Gmail para IMAP (descarga de correos de procuradores)
# y SMTP (envío del informe diario). Generada en:
# https://myaccount.google.com/apppasswords
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Rutas Windows (sobreescriben config.json si se definen) ──
# PIPELINE_BASE_DIR=C:\Users\santi\OneDrive - Aserges\DOCS-MNPROGRAM_1631
# PIPELINE_NOTIFICACIONES_DIR=C:\Users\santi\OneDrive - Aserges\DOCS-MNPROGRAM_1631\Notificaciones
# PIPELINE_USU2_DIR=C:\Users\santi\OneDrive - Aserges\DOCS-MNPROGRAM_1631\Usu2
# PIPELINE_TRABAJO_DIR=C:\Users\santi\OneDrive - Aserges\judicial_diario
